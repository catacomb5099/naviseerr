  "cards": [
    {
      "dot": "cyan",
      "title": "Three repositories, one stack",
      "items": [
        "naviseerr — Java 21 · Spring Boot 4 WebFlux · R2DBC",
        "naviseerr-client — React 18 + Vite SPA",
        "ytmusic-adapter — FastAPI sidecar over ytmusicapi 1.12.2"
      ]
    },
    {
      "dot": "emerald",
      "title": "Client triggers, all alike",
      "items": [
        "GET /search/{query} — hits SearchService directly",
        "POST /download/{songName} — hits DownloadController, 202",
        "GET /downloads/active — polled every 5s for stage"
      ]
    },
    {
      "dot": "amber",
      "title": "Deliberate omissions",
      "items": [
        "No broker, no cache tier — Postgres is the workflow engine",
        "No SSE — the client polls /downloads/active",
        "No user accounts or authorization"
      ]
    }
  ]
