# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# Spring loads .env automatically (see spring.config.import in application.yaml) as long as it
# sits in the working directory the app is started from (the repo root for `./gradlew bootRun`).
# Java-properties syntax: KEY=VALUE, one per line, no quoting needed for plain tokens.

# Required. slskd's own API key (slskd web UI -> Options -> Security), not a naviseerr secret.
SLSKD_API_KEY=

# Optional, and unused as of 10-08-2026. Search runs through ytmusic-adapter, so nothing calls
# Last.fm and application.yaml carries a placeholder default. Only set this if Last.fm is re-enabled.
# Last.fm API key: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional. Where the ytmusic-adapter sidecar is reachable. Defaults to http://localhost:8000, which
# is what compose.yaml publishes - override only if you run the adapter elsewhere.
YT_MUSIC_SERVICE_URL=

# Optional. Host port compose publishes the adapter on. Defaults to 8000. Change this if 8000 is
# taken, and point YT_MUSIC_SERVICE_URL at the same port if you do.
YTMUSIC_ADAPTER_PORT=

# Optional. Defaults to a LAN address that only works on the original author's network.
# Point this at your own slskd instance, e.g. http://localhost:5030/api/v0/ or a remote host.
SLSKD_URL=

# Optional, as a pair. Set BOTH to have finished downloads moved out of slskd's downloads folder into an
# organised music library (Artist/Album or Title/file) that Navidrome or Jellyfin can scan. Leave both
# empty and downloads stay wherever slskd puts them, exactly as before.
# slskd's downloads folder must be visible to naviseerr: the same machine, or the same volume mounted
# into both containers. Both paths are as seen from naviseerr, not from slskd.
SLSKD_DOWNLOADS_DIR=
LIBRARY_ROOT=

# Optional. slskd's incomplete folder, as seen from naviseerr. When set, the partial file left behind by
# a song that failed for good is deleted. Leave empty to keep them.
SLSKD_INCOMPLETE_DIR=

# Optional, as a pair with the croissant service (the playlist curator). Set CURATOR_TOKEN to turn on the weekly refresh
# of suggested playlists (Mondays 03:00 by default). It is a shared secret: the SAME value must be given
# to the curator (compose.yaml passes this variable through to it). Generate one with `openssl rand -hex 32`.
# Leave empty and naviseerr never talks to the curator. The curator container is opt-in:
# `docker compose --profile curator up -d`.
CURATOR_TOKEN=

# Optional. Where the curator is reachable. Defaults to http://localhost:8010, which is what compose.yaml
# publishes - override only if you run the curator elsewhere.
CURATOR_URL=

# Optional. Host port compose publishes the curator on. Defaults to 8010.
CURATOR_PORT=
