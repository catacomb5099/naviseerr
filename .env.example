# Copy this file to .env, next to compose.yaml, and fill in SOULSEEK_USERNAME. Then
# `docker compose up -d` starts everything. .env is gitignored — never commit it. An empty value
# means "use the default".

# Required. The Soulseek username your naviseerr logs in with. The account is created the first time
# it logs in, so pick a name nobody else is likely to have: 1 to 30 characters, plain letters, digits
# and punctuation, no space at the start or end. It cannot be made up for you: Soulseek's rules forbid
# automatically generated usernames. If the name is taken, `docker compose logs slskd` says "invalid
# username or password": choose another here, then run `docker compose up -d` and
# `docker compose restart slskd`.
SOULSEEK_USERNAME=

# Optional. Only to bring a Soulseek account you already have: its password. Leave empty and one is
# generated on the first start and shown once by `docker compose logs setup`. Keep it somewhere:
# Soulseek passwords cannot be reset. If it contains $, # or a space, wrap it in single quotes, e.g.
# SOULSEEK_PASSWORD='pa$$ #1', or it reaches Soulseek changed (the same goes for SOULSEEK_USERNAME).
SOULSEEK_PASSWORD=

# Optional. The folder on this machine your music library goes in. Defaults to ./library, next to this
# file. Point Navidrome or Jellyfin at the same folder: finished songs, and playlists as .m3u8 files,
# appear there.
LIBRARY_DIR=

# Optional. The port the web app is published on: http://<this machine>:5056 by default.
NAVISEERR_PORT=

# Optional. Whether your music library is shared on Soulseek. Defaults to true. Soulseek expects you to
# share: other users may refuse or slow down people who share nothing. You are responsible for what
# you share. Sharing makes refusals less likely, but nothing makes an account unbannable. Set to false
# to share nothing.
SHARE_LIBRARY=

# Optional. The user and group every naviseerr container runs as, so the library's files belong to you.
# Defaults to 1000 and 1000; find yours with `id -u` and `id -g`.
PUID=
PGID=

# Optional. Your time zone, e.g. Europe/London. Defaults to UTC. The weekly curator refresh runs on it.
TZ=

# Optional, as a pair with the croissant service (the playlist curator). Set CURATOR_TOKEN to turn on the weekly refresh
# of suggested playlists (Mondays 03:00 by default). It is a shared secret: the SAME value must be given
# to the curator (both compose files pass this variable through to it). Generate one with `openssl rand -hex 32`.
# Leave empty and naviseerr never talks to the curator. The curator container is opt-in:
# `docker compose --profile curator up -d` (developers: add `-f compose.dev.yaml`).
CURATOR_TOKEN=

# Optional. How much `docker compose logs naviseerr` shows. Defaults to INFO: what happened to each
# download, and every problem. Set to DEBUG for the step-by-step detail (a lot more lines, useful when
# reporting a bug), then run `docker compose up -d`.
LOG_LEVEL=


# ==================================================================================================
# Only for developers running the server outside Docker (IntelliJ or `./gradlew bootRun`, with
# compose.dev.yaml). The all-in-one install sets all of these itself and ignores what is below.
#
# Spring loads .env automatically (see spring.config.import in application.yaml) as long as it
# sits in the working directory the app is started from (the repo root for `./gradlew bootRun`).
# Java-properties syntax: KEY=VALUE, one per line, no quoting needed for plain tokens.
# ==================================================================================================

# Required. slskd's own API key (slskd web UI -> Options -> Security), not a naviseerr secret.
SLSKD_API_KEY=

# Required. Where your slskd is, e.g. http://localhost:5030/api/v0/ or a remote host. There is no
# default.
SLSKD_URL=

# Optional, and unused as of 10-08-2026. Search runs through ytmusic-adapter, so nothing calls
# Last.fm and application.yaml carries a placeholder default. Only set this if Last.fm is re-enabled.
# Last.fm API key: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional. Where the ytmusic-adapter sidecar is reachable. Defaults to http://localhost:8000, which
# is what compose.dev.yaml publishes - override only if you run the adapter elsewhere.
YT_MUSIC_SERVICE_URL=

# Optional. Host port compose publishes the adapter on. Defaults to 8000. Change this if 8000 is
# taken, and point YT_MUSIC_SERVICE_URL at the same port if you do.
YTMUSIC_ADAPTER_PORT=

# Optional, as a pair. Set BOTH to have finished downloads moved out of slskd's downloads folder into an
# organised music library (Artist/Album or Title/file) that Navidrome or Jellyfin can scan. Leave both
# empty and downloads stay wherever slskd puts them, exactly as before.
# slskd's downloads folder must be visible to naviseerr: the same machine, or the same volume mounted
# into both containers. Both paths are as seen from naviseerr, not from slskd.
SLSKD_DOWNLOADS_DIR=
LIBRARY_ROOT=

# Optional. slskd's incomplete folder, as seen from naviseerr. When set, the partial file left behind by
# a song that failed for good is deleted. Leave empty to keep them.
SLSKD_INCOMPLETE_DIR=

# Optional. Where the curator is reachable. Defaults to http://localhost:8010, which is what compose.dev.yaml
# publishes - override only if you run the curator elsewhere.
CURATOR_URL=

# Optional. Host port compose publishes the curator on. Defaults to 8010.
CURATOR_PORT=
