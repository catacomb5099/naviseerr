# Settings for scripts/e2e/playlist-file.sh only. No secrets: this Soulseek account never logs in
# (compose.e2e.yaml seals slskd off from the internet). The password is left empty so setup generates a
# throwaway one inside the stack's own volume: nothing public could ever log in as this account, even
# if someone ran compose.yaml with this file and without the sealing override.
SOULSEEK_USERNAME=e2e-sealed
SOULSEEK_PASSWORD=
NAVISEERR_PORT=5096
SHARE_LIBRARY=false
